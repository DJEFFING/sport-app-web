### ===========================================
### TESTS API TOURNAMENTS - CRUD COMPLET
### ===========================================

### Variables (Remplacez ces valeurs par vos vraies données)
@baseUrl = http://127.0.0.1:8000/api
@organizerId = 3ae4bff9-3f45-4d5e-8e31-3aad2f46a48c
@tournamentId = 7bf097e7-95b2-478b-be80-01473347cc10


### ===========================================
### 1. LECTURE (GET) - Lister tous les tournois
### ===========================================
GET {{baseUrl}}/tournaments/
Content-Type: application/json


### ===========================================
### 2. CRÉATION (POST) - Créer des tournois
### ===========================================

### Tournoi 1 - Coupe d'Automne
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Tournoi de la Capitale",
    "sport": "Soccer",
    "city": "Ottawa",
    "start_date": "2026-06-01",
    "end_date": "2025-12-07",
    "organizer": "{{organizerId}}"
}

###

### Tournoi 2 - Tournoi d'Hiver
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Tournoi de la Capitale",
    "sport": "Soccer",
    "city": "Ottawa",
    "start_date": "2026-06-01",
    "end_date": "2026-01-22",
    "organizer": "{{organizerId}}"
}

###

### Tournoi 3 - Championnat Printemps
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Ligue d'Été de Montréal",
    "sport": "Basketball",
    "city": "Montréal",
    "start_date": "2026-07-20",
    "end_date": "2026-04-17",
    "organizer": "{{organizerId}}"
}

###

### Tournoi 4 - Tournoi Express (courte durée)
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Tournoi Express Weekend",
    "city": "Longeuil",
    "sport": "Volelball",
    "start_date": "2026-02-20",
    "end_date": "2026-02-21",
    "organizer": "{{organizerId}}"
}

###

### Tournoi 5 - Coupe d'Été
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Coupe d'Été International",
    "city": "Longeuil",
    "sport": "Volelball",
    "start_date": "2026-07-01",
    "end_date": "2026-07-15",
    "organizer": "{{organizerId}}"
}

###

### Tournoi 6 - Sans location (optionnel)
POST {{baseUrl}}/tournaments/
Content-Type: application/json

{
    "name": "Tournoi Virtuel Online",
    "sport": "Basketball",
    "city": "Montréal",
    "start_date": "2026-03-01",
    "end_date": "2026-03-31",
    "organizer": "{{organizerId}}"
}

### -----------------------------------------------------
### [2] Lire la liste des tournois (GET List)
### -----------------------------------------------------

# Le serveur doit renvoyer 200 OK et la liste des 3 tournois créés
# (si vous êtes connecté avec le même utilisateur).
GET {{baseUrl}}/tournaments/ HTTP/1.1

### -----------------------------------------------------
### [3] Lire un tournoi spécifique (GET Detail)
### -----------------------------------------------------

# 1. Exécutez le GET List ci-dessus. 
# 2. Copiez l'ID (UUID) de l'un des tournois.
# 3. Collez l'ID dans la variable @tournamentId ci-dessus.

GET {{baseUrl}}/tournaments/{{tournamentId}}/ HTTP/1.1

### -----------------------------------------------------
### [4] Mettre à jour un tournoi (PUT/PATCH)
### -----------------------------------------------------

# PUT remplace l'intégralité de l'objet, PATCH met à jour partiellement.
# Utilisez l'ID copié à l'étape [3].

PATCH {{baseUrl}}/tournaments/{{tournamentId}}/ HTTP/1.1
Content-Type: application/json

{
    "name": "Coupe d'Hiver de Longueuil - ÉDITION FINALE",
    "city": "Boucherville"
    // Le sport et la date restent inchangés car c'est un PATCH
}

### -----------------------------------------------------
### [5] Supprimer un tournoi (DELETE)
### -----------------------------------------------------

# Le serveur doit renvoyer 204 No Content en cas de succès.
# Utilisez l'ID copié à l'étape [3].

DELETE {{baseUrl}}/tournaments/{{tournamentId}}/ HTTP/1.1